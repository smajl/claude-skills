{
  "version": 7,
  "ticketPattern": "[A-Z][A-Z0-9]{1,9}-\\d+",
  "identity": {
    "gitAuthors": [
      "you@example.com",
      "Your Name"
    ],
    "gitlabUsername": "yourhandle",
    "githubUsername": null,
    "harvestUserId": 0,
    "timezone": "Europe/Prague"
  },
  "repos": {
    "roots": [
      "C:/dev"
    ],
    "depth": 2,
    "include": [
      "product-web",
      "product-api"
    ],
    "exclude": [],
    "projectByRepo": {}
  },
  "sources": {
    "git": {
      "enabled": true
    },
    "gitlab": {
      "enabled": true,
      "host": "gitlab.com"
    },
    "github": {
      "enabled": false
    },
    "calendar": {
      "enabled": true,
      "calendars": [
        "primary"
      ]
    },
    "jira": {
      "enabled": true,
      "cloudId": "",
      "projectRouting": {}
    },
    "confluence": {
      "enabled": true,
      "cloudId": "",
      "includePageEdits": true
    },
    "slack": {
      "enabled": false,
      "channels": [],
      "messages": {
        "enabled": true,
        "ignoreChannels": [
          "^#?random$",
          "^#?social$",
          "^#?watercooler$"
        ]
      },
      "huddles": {
        "enabled": true,
        "tokenEnv": "HARVEST_LOG_SLACK_TOKEN",
        "conversations": [],
        "conversationTypes": "im,mpim,private_channel,public_channel",
        "maxConversations": 80,
        "coalesceGapMinutes": 10,
        "fallbackHuddleHours": 0.5
      }
    }
  },
  "harvest": {
    "tokenEnv": "HARVEST_TOKEN",
    "accountIdEnv": "HARVEST_ACCOUNT_ID",
    "defaultProjectId": 0,
    "targetHoursPerDay": 8,
    "roundToHours": 0.25,
    "noteStyle": "Ticket key first, then a short lowercase summary of what was done.",
    "taskRules": [
      {
        "match": "standup|sync|retro|grooming|demo|1on1|1-1|architecture",
        "taskId": 0,
        "taskName": "Meetings"
      },
      {
        "match": "interview|candidate|hiring|screen",
        "projectId": 0,
        "taskId": 0,
        "taskName": "Recruiting"
      },
      {
        "match": "training|learning|course|reading|doc review",
        "taskId": 0,
        "taskName": "Training & Learning"
      },
      {
        "match": "fix|bug|refactor|maintenance|upgrade|chore",
        "taskId": 0,
        "taskName": "Maintenance"
      },
      {
        "match": ".*",
        "taskId": 0,
        "taskName": "Feature"
      }
    ],
    "learnedRoutes": [],
    "calibration": {
      "hoursPerScore": 0.28,
      "medianHoursByTask": {},
      "dayTotals": {
        "weekday": null,
        "weekdayWithEveningSession": null,
        "weekend": null,
        "weekendWithEveningSession": null
      },
      "medianWorkEntriesPerDay": null,
      "computedFrom": null,
      "samples": 0
    }
  },
  "rules": {
    "dayStartHour": 3,
    "skipWeekends": true,
    "weekendsWithEvidence": true,
    "sessionGapMinutes": 90,
    "eveningSessionHour": 19,
    "eveningFloorEvents": 3,
    "eveningFloorSpanMinutes": 15,
    "ignoreEventPatterns": [
      "ooo",
      "out of office",
      "holiday",
      "focus",
      "lunch",
      "blocked",
      "pto"
    ],
    "catchUpWindowDays": 14
  }
}
